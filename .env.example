# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/usgoods_pasabuy?schema=public"

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Real Gmail / SMTP Verification Code Delivery (Recommended for 100% Gmail Deliverability)
# How to get Google App Password:
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "US Goods PasaBuy") and copy the 16-character password
GMAIL_USER="your-store-email@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
EMAIL_FROM_NAME="US Goods PasaBuy"

# Alternative: Resend API Key (https://resend.com)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="US Goods PasaBuy <security@usgoodspasabuy.ph>"

# JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# S3 / Cloudflare R2 Credentials for Proof-of-Payment Receipts
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_BUCKET_NAME="pasabuy-receipts"
NEXT_PUBLIC_STORAGE_PUBLIC_URL="https://pub-receipts.yourdomain.com"

# Business Settings Defaults
DEFAULT_USD_TO_PHP_RATE="59.00"
DEFAULT_CARGO_RATE_PER_LB="7.50"
DEFAULT_HANDLING_FEE_USD="3.00"

# Application Port
PORT=3000
